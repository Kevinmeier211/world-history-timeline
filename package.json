{
  "name": "chronos-world-history-timeline",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run content:build && tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false --noEmit",
    "lint": "eslint . && prettier --check .",
    "design:lint": "tsx scripts/design-lint.ts",
    "test": "vitest run --coverage",
    "validate:data": "tsx scripts/validate-data.ts",
    "palette:check": "tsx scripts/palette-check.ts",
    "layout:report": "tsx scripts/layout-report.ts",
    "watermark": "tsx scripts/make-watermark.ts",
    "report:unverified": "tsx scripts/report-unverified.ts",
    "shots": "tsx scripts/shots.ts",
    "axe": "node scripts/redesign/run-browser-suite.mjs --axe-only",
    "bundle:check": "npm run build && tsx scripts/bundle-size.ts",
    "perf": "tsx scripts/perf.ts",
    "media:plan": "tsx scripts/media/plan.ts",
    "media:fetch": "tsx scripts/media/fetch.ts",
    "media:process": "tsx scripts/media/process.ts",
    "media:budget": "tsx scripts/media/budget.ts",
    "media:credits": "tsx scripts/media/credits.ts",
    "export:pdf": "tsx scripts/export-pdf.ts",
    "export:reference": "tsx scripts/export-reference.ts",
    "check:pdf": "tsx scripts/check-pdf.ts",
    "export:all": "tsx scripts/export-all.ts",
    "check": "npm run typecheck && npm run lint && npm run design:lint && npm run palette:check && npm run test && npm run validate:data && npm run validate:atlas -- --complete",
    "content:build": "node --import tsx scripts/redesign/compile.ts && python3 scripts/redesign/legacy-ledger.py && python3 scripts/redesign/manifests.py && node scripts/redesign/topic-registry.mjs",
    "validate:atlas": "node --import tsx scripts/redesign/validate-release.ts",
    "test:atlas": "vitest run --config vitest.atlas.config.ts --coverage",
    "test:legacy": "vitest run --config vitest.legacy.config.ts --coverage",
    "check:atlas": "npm run typecheck && npm run lint && npm run design:lint && npm run palette:check && npm run validate:atlas -- --complete && npm run test:atlas",
    "test:reading": "node scripts/redesign/reading-checks.mjs",
    "print:atlas": "node scripts/redesign/export-print.mjs",
    "preview:portable": "python3 scripts/redesign/precompress.py && python3 scripts/redesign/serve.py --root dist",
    "test:expansion": "node scripts/redesign/expansion-checks.mjs",
    "test:northern": "node scripts/redesign/expansion-checks.mjs northern",
    "test:woodlands": "node scripts/redesign/expansion-checks.mjs woodlands",
    "test:browser": "node scripts/redesign/run-browser-suite.mjs",
    "check:candidate": "npm run build && npm run check && npm run test:atlas && node --import tsx scripts/bundle-size.ts && npm run test:browser"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/source-sans-3": "^5.3.1",
    "@fontsource/source-serif-4": "^5.3.1",
    "d3-ease": "^3.0.1",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "d3-zoom": "^3.0.0",
    "rbush": "^4.0.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/d3-ease": "^3.0.2",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.2.0",
    "@types/d3-zoom": "^3.0.9",
    "@types/node": "^26.6.5",
    "@types/rbush": "^4.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-react": "^4.4.1",
    "@vitest/coverage-v8": "^5.0.5",
    "culori": "^4.0.2",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "topojson-client": "^3.1.0",
    "tsx": "^4.23.15",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.72.0",
    "vite": "^6.3.1",
    "vitest": "^5.0.5",
    "world-atlas": "^2.0.2"
  }
}
